rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función auxiliar: verifica que el usuario haya iniciado sesión en la app
    function isAuthenticated() {
      return request.auth != null;
    }

    // Archivos de tiendas (logos, productos, catálogos)
    match /stores/{storeId}/{allPaths=**} {
      // 1. Lectura pública obligatoria para que cualquier comprador vea fotos y logos
      allow read: if true;

      // 2. Creación y actualización: Comerciantes autenticados con límite de peso de 15MB
      allow write: if isAuthenticated() 
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // 3. Eliminación permitida para comerciantes autenticados
      allow delete: if isAuthenticated();
    }

    // Fallback general para cualquier otra ruta de imágenes de la app
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }
  }
}
