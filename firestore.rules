rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para identificar al SuperAdmin de APANA
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'angelo@mivo.pe' ||
        request.auth.token.email == 'angelocastellanos99@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin'
      );
    }

    // Reglas para la colección de Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == userId ||
        isSuperAdmin()
      );
    }
    
    // Reglas para la colección de Tiendas
    match /stores/{storeId} {
      // Lectura pública permitida para que cualquier comprador acceda a la tienda
      allow read: if true;
      
      // Escritura/Creación permitida para el dueño de la tienda O para el SuperAdmin
      allow create, update: if request.auth != null && (
        request.auth.uid == request.resource.data.ownerId ||
        isSuperAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        isSuperAdmin()
      );

      // Reglas para la subcolección de Analíticas
      match /analytics/{dateStr} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId ||
          isSuperAdmin()
        );
        allow create, update: if true;
        allow delete: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId ||
          isSuperAdmin()
        );
      }

      // Reglas para la subcolección de Productos
      match /products/{productId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
        allow update: if request.auth != null || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'updatedAt'])
        );
      }
    }

    // Reglas para la colección de Historial de Pagos (Payment Records)
    match /payment_records/{recordId} {
      allow read, write: if request.auth != null && isSuperAdmin();
      allow create: if request.auth != null;
    }

    // Reglas para la colección de Eventos de Suscripción (Subscription Events)
    match /subscription_events/{eventId} {
      allow read, write: if request.auth != null && isSuperAdmin();
      allow create: if request.auth != null;
    }

    // Reglas para la colección de Solicitudes OTP de WhatsApp
    match /otp_requests/{phone} {
      allow read, write: if request.auth != null || isSuperAdmin();
    }
  }
}
